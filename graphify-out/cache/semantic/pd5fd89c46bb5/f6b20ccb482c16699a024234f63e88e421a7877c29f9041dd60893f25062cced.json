{"nodes": [{"id": "docs_architecture_02_technology_decisions", "label": "Technology Decisions Doc", "file_type": "document", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_02_technology_decisions_nodejs_typescript_choice", "label": "Node.js + TypeScript Runtime Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over Python or other runtimes for a consistent language across frontend and backend, strong Express/Prisma ecosystem, and TypeScript safety without heavy overhead."}, {"id": "docs_architecture_02_technology_decisions_express_choice", "label": "Express Framework Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over NestJS or Fastify for simplicity \u2014 no unnecessary structure for a project this small."}, {"id": "docs_architecture_02_technology_decisions_postgresql_choice", "label": "PostgreSQL Database Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over MySQL or SQLite for reliability, relational modeling fit, and good Prisma support."}, {"id": "docs_architecture_02_technology_decisions_prisma_choice", "label": "Prisma ORM Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over raw SQL or other ORMs for type-safe queries, clean schema definition, and good migration tooling."}, {"id": "docs_architecture_02_technology_decisions_node_cron_choice", "label": "node-cron In-Process Scheduler Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over Redis + Bull/BullMQ or any external queue because the follow-up job is simple and low-frequency (~150 messages/day); an external queue is unnecessary infrastructure at this scale."}, {"id": "docs_architecture_02_technology_decisions_systemd_choice", "label": "systemd Process Manager Choice", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over PM2 or Docker \u2014 native to Linux, sufficient for a single service, and supports the developer's DevOps learning goal."}, {"id": "docs_architecture_02_technology_decisions_rejected_approaches", "label": "Explicitly Rejected Technology Approaches", "file_type": "rationale", "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis/external queues, Docker, Kubernetes/orchestration, NestJS, and AI-based auto-reply detection are all rejected as unnecessary complexity or out of MVP scope."}], "edges": [{"source": "docs_architecture_02_technology_decisions", "target": "docs_architecture_02_technology_decisions_nodejs_typescript_choice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/architecture/02-technology-decisions.md", "source_location": null, "weight": 1.0}, {"source": "docs_architecture_02_technology_decisions", "target": "docs_architecture_02_technology_decisions_express_choice", "relation": "references", "confid