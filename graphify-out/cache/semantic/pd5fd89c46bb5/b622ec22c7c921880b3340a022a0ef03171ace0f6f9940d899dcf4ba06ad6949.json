{"nodes": [{"id": "docs_contract_whatsapp_outreach_dashboard", "label": "WhatsApp Outreach Dashboard Contract", "file_type": "document", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_core_mvp_workflow", "label": "Core MVP Workflow (Import \u2192 Send \u2192 Follow-ups \u2192 Inbox)", "file_type": "concept", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_whatsapp_number_rules", "label": "WhatsApp Number Rules (single active number)", "file_type": "concept", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_auto_reply_requirement", "label": "Auto-Reply Requirement (best-effort, rule-based)", "file_type": "rationale", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated replies should not count as real replies, so the follow-up sequence continues; detection is best-effort via simple configurable rules/patterns rather than AI classification, since 100% accuracy cannot be promised."}, {"id": "docs_contract_whatsapp_outreach_dashboard_campaign_scope", "label": "Campaign Scope (one active campaign, daily limit ~150)", "file_type": "concept", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_compliance", "label": "Compliance Responsibilities", "file_type": "concept", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_mvp_pages", "label": "MVP Pages (Dashboard, Leads, Campaign, Inbox, Settings)", "file_type": "concept", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contract_whatsapp_outreach_dashboard_explicit_exclusions", "label": "Explicit Exclusions from $90 MVP", "file_type": "rationale", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Excludes Google Maps scraping, multiple numbers/users, AI features, advanced CRM, billing, and more \u2014 new functionality outside this list is treated as additional work, to keep the $90 MVP scope bounded."}, {"id": "docs_contract_whatsapp_outreach_dashboard_deployment_decision", "label": "Small VPS Deployment Decision", "file_type": "rationale", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small VPS is enough because the project is single-user, low-traffic (~150 messages/day), with a small database; avoids overpowered infrastructure while the backend must stay online for webhooks, API, DB, and scheduled follow-ups."}, {"id": "docs_contract_whatsapp_outreach_dashboard_devops_learning_goal", "label": "DevOps Learning Goal", "file_type": "rationale", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The developer wants to manually manage the VPS partly to gain practical DevOps experience, explicitly avoiding Kubernetes/Terraform/complex infrastructure."}, {"id": "docs_contract_whatsapp_outreach_dashboard_implementation_order", "label": "Recommended Risk-First Implementation Order", "file_type": "rationale", "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not start with frontend design; prove Meta/WhatsApp send and webhook receive first (steps 1-4) before building backend state, automation, and UI, since these are the highest-risk unknowns."}], "edges": [{"source": "docs_contract_whatsapp_outreach_dashboard", "target": "docs_contract_whatsapp_outreach_dashboard_core_mvp_workflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "weight": 1.0}, {"source": "docs_contract_whatsapp_outreach_dashboard", "target": "docs_contract_whatsapp_outreach_dashboard_whatsapp_number_rules", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "weight": 1.0}, {"source": "docs_contract_whatsapp_outreach_dashboard", "target": "docs_contract_whatsapp_outreach_dashboard_auto_reply_requirement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "weight": 1.0}, {"source": "docs_contract_whatsapp_outreach_dashboard", "target": "docs_contract_whatsapp_outreach_dashboard_campaign_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/contract/WhatsApp Outreach Dashboard.md", "source_location": null, "weight": 1.0}, {"source": "docs_contract_whatsapp_outreach_dashboard", "target": "docs_contract_whatsapp_outreach_dashboard_compliance", "relation": "references", "confidence": "EXTRACT