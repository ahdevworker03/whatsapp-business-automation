{"nodes": [{"id": "claude_skills_prisma_skill", "label": "Prisma ORM Skill", "file_type": "document", "source_file": ".claude/skills/prisma/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_prisma_skill_single_prismaclient_instance", "label": "Single PrismaClient Instance Principle", "file_type": "rationale", "source_file": ".claude/skills/prisma/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Create one global PrismaClient instance and reuse it; multiple instances create multiple connection pools that can exhaust the database's connection limit."}, {"id": "claude_skills_prisma_skill_type_safety_by_default", "label": "Type Safety by Default Principle", "file_type": "rationale", "source_file": ".claude/skills/prisma/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leverage Prisma's generated types instead of duplicating interfaces to keep queries and TypeScript types in sync."}, {"id": "claude_skills_prisma_skill_prefer_orm_over_raw_sql", "label": "Prefer ORM API Over Raw SQL Principle", "file_type": "rationale", "source_file": ".claude/skills/prisma/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Prisma's query API by default since it is parameterized and safe; use raw SQL only for unsupported features, always parameterized to avoid SQL injection."}], "edges": [{"source": "claude_skills_prisma_skill_type_safety_by_default", "target": "claude_skills_typescript_skill_unknown_over_any", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": ".claude/skills/prisma/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_prisma_skill", "target": "claude_skills_prisma_skill_sin