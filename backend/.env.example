# Server
PORT=3000
NODE_ENV=development

# Meta Cloud API (WhatsApp Business Platform)
# From Meta App Dashboard > WhatsApp > API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

# Graph API version used for all Meta Cloud API calls.
# Not part of docs/architecture/03-backend-architecture.md's env var list;
# added because the Meta Graph API requires a version segment in every request URL.
META_API_VERSION=v21.0

# Shared secret used to verify Meta's webhook subscription request
# (GET /webhook?hub.verify_token=...). Set this to any value you choose,
# then enter the same value in the Meta App Dashboard webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# PostgreSQL connection string. Use a dedicated database and a dedicated
# app user (not the postgres superuser) — see docs/development-milestones/
# 02-backend-foundation-data-model.md, Step 1.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
